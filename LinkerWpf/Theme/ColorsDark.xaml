<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canonical Nord Brushes -->
    <SolidColorBrush x:Key="Nord0Brush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="Nord1Brush" Color="#FF3B4252"/>
    <SolidColorBrush x:Key="Nord2Brush" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="Nord3Brush" Color="#FF4C566A"/>
    <SolidColorBrush x:Key="Nord4Brush" Color="#FFD8DEE9"/>
    <SolidColorBrush x:Key="Nord5Brush" Color="#FFE5E9F0"/>
    <SolidColorBrush x:Key="Nord6Brush" Color="#FFECEFF4"/>
    <SolidColorBrush x:Key="Nord7Brush" Color="#FF8FBCBB"/>
    <SolidColorBrush x:Key="Nord8Brush" Color="#FF88C0D0"/>
    <SolidColorBrush x:Key="Nord9Brush" Color="#FF81A1C1"/>
    <SolidColorBrush x:Key="Nord10Brush" Color="#FF5E81AC"/>
    <SolidColorBrush x:Key="Nord11Brush" Color="#FFBF616A"/>
    <SolidColorBrush x:Key="Nord12Brush" Color="#FFD08770"/>
    <SolidColorBrush x:Key="Nord13Brush" Color="#FFEBCB8B"/>
    <SolidColorBrush x:Key="Nord14Brush" Color="#FFA3BE8C"/>
    <SolidColorBrush x:Key="Nord15Brush" Color="#FFB48EAD"/>

    <!-- Theme Role Mappings (Dark Mode) -->
    <!-- Primary interactive color: nord9 (#81A1C1) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF81A1C1"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#FFECEFF4"/>

    <!-- Secondary & Tertiary accents -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#FF8FBCBB"/>
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="#FFECEFF4"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="#FF88C0D0"/>
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="#FFECEFF4"/>

    <!-- Surfaces: page bg nord0, main surface nord1, nested surface nord2 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="#FFECEFF4"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF3B4252"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#FFD8DEE9"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#FF98A2B1"/>
    <SolidColorBrush x:Key="SurfaceTintBrush" Color="#FF81A1C1"/>
    <SolidColorBrush x:Key="SurfaceDimBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="SurfaceBrightBrush" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#FF3B4252"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#FF3B4252"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#FF434C5E"/>

    <!-- Error & destructive: nord11 -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFBF616A"/>
    <SolidColorBrush x:Key="OnErrorBrush" Color="#FFECEFF4"/>
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="#FFBF616A"/>
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="#FFECEFF4"/>

    <!-- Warning: nord13 yellow -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FFEBCB8B"/>
    <SolidColorBrush x:Key="OnWarningBrush" Color="#FF2E3440"/>

    <!-- Borders & outlines: nord3 quiet border, nord2/nord1 subtle divider -->
    <SolidColorBrush x:Key="OutlineBrush" Color="#FF4C566A"/>
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="InverseSurfaceBrush" Color="#FFECEFF4"/>
    <SolidColorBrush x:Key="InverseOnSurfaceBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="InversePrimaryBrush" Color="#FF5E81AC"/>

    <!-- Primary button: filled nord9 with dark text -->
    <SolidColorBrush x:Key="FilledButtonBackgroundBrush" Color="#FF81A1C1"/>
    <SolidColorBrush x:Key="FilledButtonHoverBackgroundBrush" Color="#FF88C0D0"/>
    <SolidColorBrush x:Key="FilledButtonForegroundBrush" Color="#FF2E3440"/>

    <!-- Row hover: nord2 nested surface -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#FF434C5E"/>
</ResourceDictionary>
