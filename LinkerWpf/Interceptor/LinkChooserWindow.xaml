<Window x:Class="Linker.Interceptor.LinkChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:comp="clr-namespace:Linker.Ui.Components"
        xmlns:util="clr-namespace:Linker.Util"

        Title="Linker" Width="440" MinWidth="380" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Assets/app.ico"
        Loaded="OnWindowLoaded"
        KeyboardNavigation.TabNavigation="Continue"
        KeyboardNavigation.ControlTabNavigation="Continue"
        KeyboardNavigation.DirectionalNavigation="None">
    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Domain header row -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding EditableUrl, Converter={StaticResource UrlToHostConverter}}"
                           Style="{StaticResource title}" FontSize="14" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="2" Style="{StaticResource IconButtonTheme}" Click="OnCopyClick" ToolTip="Copy link"
                        Margin="4,0,0,0">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource IconButtonTheme}" Click="OnSaveClick" ToolTip="Save link"
                        Margin="4,0,0,0">
                    <Grid>
                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource PrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlreadySaved}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlreadySaved}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
            </Grid>

            <!-- URL text box -->
            <TextBox Grid.Row="1" x:Name="UrlTextBox" Style="{StaticResource outlined}"
                     Text="{Binding EditableUrl, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="True" MinLines="4" MaxLines="4"
                     MinWidth="200" FontSize="12" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

            <Border Grid.Row="2" Height="1" Background="{DynamicResource OutlineVariantBrush}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="3" Text="Open with" Style="{StaticResource label}" Margin="0,0,0,8"/>

            <Grid Grid.Row="4" Height="284">
                <TextBlock Text="No browsers to show. Check Manage Browsers."
                           TextWrapping="Wrap" Margin="0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource bodySmall}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding LoadingBrowsers}" Value="False"/>
                                        <Condition Binding="{Binding Browsers.Count}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="BrowserList" ItemsSource="{Binding Browsers}" Background="Transparent" BorderThickness="0"
                         Padding="0,0,10,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         GotKeyboardFocus="OnBrowserListGotKeyboardFocus"
                         KeyDown="OnBrowserListKeyDown"
                         util:SmoothScroll.Enabled="True">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LoadingBrowsers}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="rowBg" Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="rowBg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="rowBg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type DataRepositories:BrowserListItem}"
                                      xmlns:DataRepositories="clr-namespace:Linker.Data.Repositories">
                            <Grid Height="34" Margin="12,8" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnBrowserRowClick">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0">
                                    <Image Source="{Binding Icon}" Width="28" Height="28"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}"
                                           FontFamily="{DynamicResource MartianMonoMedium}"
                                           VerticalAlignment="Center" FontSize="13"/>
                                <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource IconButtonTheme}"
                                        AutomationProperties.Name="Open in a private window"
                                        ToolTip="Open in a private window"
                                        Visibility="{Binding PrivateWindowArgument, Converter={StaticResource EmptyStringToVisibilityConverter}}"
                                        Click="OnPrivateClick">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M8.37891 4.5C7.88874 4.5 7.44379 4.7865 7.24096 5.23275L6.18295 7.56035C6.01155 7.93744 5.56691 8.10418 5.18983 7.93278C4.81274 7.76137 4.646 7.31673 4.8174 6.93965L5.87541 4.61204C6.32165 3.63031 7.30052 3 8.37891 3H15.6216C16.6999 3 17.6787 3.63016 18.125 4.61173L19.1829 6.93841C19.3544 7.31547 19.1877 7.76013 18.8106 7.93158C18.4336 8.10303 17.9889 7.93635 17.8174 7.55928L16.7595 5.2326C16.5566 4.78644 16.1117 4.5 15.6216 4.5H8.37891ZM6.50018 13.5C4.84332 13.5 3.50018 14.8431 3.50018 16.5C3.50018 18.1569 4.84332 19.5 6.50018 19.5C8.15703 19.5 9.50018 18.1569 9.50018 16.5C9.50018 14.8431 8.15703 13.5 6.50018 13.5ZM2.00018 16.5C2.00018 14.0147 4.0149 12 6.50018 12C8.81646 12 10.724 13.75 10.9727 16H13.0276C13.2764 13.75 15.1839 12 17.5002 12C19.9855 12 22.0002 14.0147 22.0002 16.5C22.0002 18.9853 19.9855 21 17.5002 21C15.3586 21 13.5664 19.504 13.1117 17.5H10.8887C10.4339 19.504 8.64177 21 6.50018 21C4.0149 21 2.00018 18.9853 2.00018 16.5ZM17.5002 13.5C15.8433 13.5 14.5002 14.8431 14.5002 16.5C14.5002 18.1569 15.8433 19.5 17.5002 19.5C19.157 19.5 20.5002 18.1569 20.5002 16.5C20.5002 14.8431 19.157 13.5 17.5002 13.5ZM2.93409 10.973C8.06339 9.67567 15.937 9.67564 21.0663 10.973C21.4678 11.0746 21.8757 10.8314 21.9773 10.4299C22.0789 10.0283 21.8357 9.62041 21.4341 9.51884C16.0634 8.16037 7.93697 8.16041 2.56627 9.51884C2.1647 9.62041 1.92151 10.0283 2.02308 10.4298C2.12465 10.8314 2.53252 11.0746 2.93409 10.973Z"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <comp:ToastHostControl Grid.Row="0" Grid.RowSpan="7" Panel.ZIndex="10" Margin="0,0,0,42"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>

            <Grid Grid.Row="6" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Manage browsers" Style="{StaticResource OutlinedButtonTheme}"
                        Click="OnManageBrowsersClick"/>
                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource PlainTextButtonTheme}"
                        Click="OnCancelClick"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
