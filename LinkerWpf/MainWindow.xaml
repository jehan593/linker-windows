<Window x:Class="Linker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:home="clr-namespace:Linker.Ui.Home"
        xmlns:browsers="clr-namespace:Linker.Ui.Browsers"
        xmlns:savedlinks="clr-namespace:Linker.Ui.SavedLinks"
        xmlns:comp="clr-namespace:Linker.Ui.Components"
        Title="Linker" Height="640" Width="480" MinHeight="420" MinWidth="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="Assets/app.ico"
        Activated="OnWindowActivated">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top app bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceContainerBrush}" Padding="16,12"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource OutlineVariantBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/icon-256.png" Width="22" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="Linker" Style="{StaticResource title}" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <home:DefaultBrowserBanner x:Name="Banner" Grid.Row="1">
            <home:DefaultBrowserBanner.Style>
                <Style TargetType="home:DefaultBrowserBanner">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDefaultBrowser}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </home:DefaultBrowserBanner.Style>
        </home:DefaultBrowserBanner>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource OutlineVariantBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="BrowsersTab" Grid.Column="0" Content="Browsers" Click="OnBrowsersTabClick"
                              Style="{StaticResource TabButtonTheme}" IsChecked="True" Height="44"/>
                <ToggleButton x:Name="SavedLinksTab" Grid.Column="1" Content="Saved Links" Click="OnSavedLinksTabClick"
                              Style="{StaticResource TabButtonTheme}" Height="44"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Background="{DynamicResource BackgroundBrush}">
            <browsers:ManageBrowsersView x:Name="BrowsersView"/>
            <savedlinks:SavedLinksView x:Name="SavedLinksView" Visibility="Collapsed"/>
            <comp:ToastHostControl x:Name="ToastHostControl"/>
        </Grid>
    </Grid>
</Window>
