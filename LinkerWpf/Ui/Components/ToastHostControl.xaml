<UserControl x:Class="Linker.Ui.Components.ToastHostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Border x:Name="Bubble" Background="#FFFFFF" CornerRadius="8"
             BorderBrush="#DADADA" BorderThickness="1"
             Padding="14,7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
             Opacity="0" Visibility="Collapsed">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Color="#000000" Opacity="0.25"/>
        </Border.Effect>
        <TextBlock x:Name="MessageText" FontFamily="{DynamicResource MartianMono}"
                    Foreground="#111111" FontSize="12"/>
    </Border>
</UserControl>
