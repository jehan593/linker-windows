<UserControl x:Class="Linker.Ui.Components.ToastHostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Border x:Name="Bubble" Background="{DynamicResource InverseSurfaceBrush}" CornerRadius="6"
            Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
            Opacity="0" Visibility="Collapsed">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.3"/>
        </Border.Effect>
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource InverseOnSurfaceBrush}" FontSize="11"/>
    </Border>
</UserControl>
