<UserControl x:Class="Linker.Ui.Browsers.ManageBrowsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:repo="clr-namespace:Linker.Data.Repositories"
             xmlns:local="clr-namespace:Linker.Ui.Browsers">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type repo:BrowserListItem}">
            <Border Margin="16,4,16,4" Padding="12,10" CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Hidden}" Value="True">
                                <Setter Property="Opacity" Value="0.60"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0">
                        <Image Source="{Binding Icon}" Width="32" Height="32"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayLabel}" FontFamily="{DynamicResource MartianMonoMedium}" FontSize="13"/>
                        <TextBlock Text="{Binding SystemLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource bodySmall}">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayLabel}" Value="{x:Static system:String.Empty}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button Click="OnMoveUpClick" ToolTip="Move up">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MoveButtonTheme}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="IsEnabled">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource MoveAvailabilityConverter}" ConverterParameter="up">
                                                <Binding Path="Id"/>
                                                <Binding Path="DataContext.Browsers" ElementName="BrowsersList"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hidden}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                        </Button>
                        <Button Click="OnMoveDownClick" ToolTip="Move down">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MoveButtonTheme}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="IsEnabled">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource MoveAvailabilityConverter}" ConverterParameter="down">
                                                <Binding Path="Id"/>
                                                <Binding Path="DataContext.Browsers" ElementName="BrowsersList"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hidden}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="3" Style="{StaticResource IconButtonTheme}" Click="OnEditClick" ToolTip="Edit browser"
                            Margin="2,0,4,0">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>

                    <CheckBox Grid.Column="4" VerticalAlignment="Center"
                              Click="OnVisibilityToggled" Margin="4,0,0,0">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource SwitchTheme}">
                                <Setter Property="ToolTip" Value="Hide from chooser"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hidden}" Value="True">
                                        <Setter Property="ToolTip" Value="Show in chooser"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                        <CheckBox.IsChecked>
                            <Binding Path="Hidden" Converter="{StaticResource InverseBoolConverter}" Mode="OneWay"/>
                        </CheckBox.IsChecked>
                    </CheckBox>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:HiddenSectionHeader}">
            <TextBlock Text="Hidden" Style="{StaticResource label}" Margin="20,12,16,4"
                       Foreground="{DynamicResource OutlineBrush}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,8,16,4">
            <TextBlock Text="Installed browsers" Style="{StaticResource label}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButtonTheme}" Click="OnAddBrowserClick" ToolTip="Add browser" Margin="2,0">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource IconButtonTheme}" Click="OnRefreshClick" ToolTip="Refresh browser list" Margin="2,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Browsers.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                       Foreground="{DynamicResource OutlineBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="No browsers found on this device." Style="{StaticResource bodySmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
        </StackPanel>

        <ListBox x:Name="BrowsersList" Grid.Row="1"
                 ItemsSource="{Binding Browsers}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource BrowserRowItemTheme}"/>
    </Grid>
</UserControl>