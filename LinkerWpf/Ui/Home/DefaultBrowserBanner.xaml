<UserControl x:Class="Linker.Ui.Home.DefaultBrowserBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="16,12,16,0" Padding="12">
        <StackPanel>
            <TextBlock Text="Linker isn't your default browser yet" Style="{StaticResource title}"
                       Foreground="{DynamicResource OnSurfaceBrush}" FontSize="13"/>
            <TextBlock Text="Make Linker your default so every link opens with a chooser first."
                       Style="{StaticResource bodySmall}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,12"/>
            <Button Content="Set as default" Style="{StaticResource FilledButtonTheme}"
                    HorizontalAlignment="Stretch" Click="OnRequestDefaultClick"/>
        </StackPanel>
    </Border>
</UserControl>
